{
    "name": "Trading bot",
    "image": "mcr.microsoft.com/devcontainers/python:3.14",
    "features": {
        "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {},
        "ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {},
        "ghcr.io/devcontainers/features/node:2.1.2": {
            "version": "lts"
        },
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    // Persist Claude Code authentication, history, and config across container rebuilds
    "mounts": [
        "source=claude-code-config,target=/home/vscode/.claude,type=volume",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    // Set environment variables for non-interactive logins and custom config directories
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    },
    "postCreateCommand": "uv sync",
    // Run as non-root user matching the default image username
    "remoteUser": "vscode"
}